{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reidom.local/protocol/command.v2.schema.json",
  "title": "Reidom Domain Command v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "command_id",
    "idempotency_key",
    "project_id",
    "base_revision",
    "source",
    "type",
    "payload",
    "reason",
    "preview"
  ],
  "properties": {
    "schema": { "const": "reidom-command/v2" },
    "command_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 128 },
    "project_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "base_revision": { "type": "integer", "minimum": 0 },
    "source": {
      "enum": ["user", "ai", "controller", "importer", "engine"]
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "maxLength": 128
    },
    "selection_ref": { "type": ["string", "null"], "maxLength": 256 },
    "payload": { "type": "object", "maxProperties": 128 },
    "reason": { "type": "string", "maxLength": 280 },
    "preview": { "type": "boolean" }
  }
}
